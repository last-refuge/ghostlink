# Build the current upstream checkout, or a specific CI checkout via GHOSTLINK_SOURCE_URL.
pkgname=ghostlink-git
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc='SSH workspace with grouped tabs and split terminals'
arch=('x86_64' 'aarch64')
url='https://github.com/last-refuge/ghostlink'
depends=('gcc-libs' 'fontconfig' 'freetype2' 'libxcb' 'libx11' 'libxkbcommon' 'libxkbcommon-x11'
         'wayland' 'vulkan-icd-loader' 'zlib' 'ttf-dejavu')
makedepends=('git' 'rustup' 'clang' 'cmake' 'pkgconf' 'curl' 'tar' 'xz')
checkdepends=('openssh')
provides=('ghostlink')
conflicts=('ghostlink')
# makepkg's GCC LTO is incompatible with Cargo's native C archives (ring and
# our terminal bridge). Keep Cargo's release profile and avoid a split debug
# package: https://wiki.archlinux.org/title/Rust_package_guidelines
options=('!lto' '!debug')
source=("ghostlink::${GHOSTLINK_SOURCE_URL:-git+https://github.com/last-refuge/ghostlink.git#branch=main}")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/ghostlink"
    local version
    version="$(sed -n 's/^version = "\([^"]*\)"/\1/p' Cargo.toml)"
    printf '%s.r%s.g%s' "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cd "$srcdir/ghostlink"
    bash scripts/bootstrap.sh
    bash scripts/dev.sh release
}

check() {
    cd "$srcdir/ghostlink"
    bash scripts/dev.sh test
}

package() {
    cd "$srcdir/ghostlink"
    source scripts/common.sh
    install -Dm755 "$CARGO_TARGET_DIR/release/ghostlink" "$pkgdir/usr/bin/ghostlink"
    install -Dm644 packaging/linux/io.github.last-refuge.ghostlink.desktop \
        "$pkgdir/usr/share/applications/io.github.last-refuge.ghostlink.desktop"
    install -Dm644 branding/ghostlink-logo-v1.png "$pkgdir/usr/share/pixmaps/ghostlink.png"
    install -Dm644 README.md "$pkgdir/usr/share/doc/ghostlink/README.md"
    install -Dm644 docs/building.md "$pkgdir/usr/share/doc/ghostlink/docs/building.md"
    install -Dm644 docs/theme-licenses.md "$pkgdir/usr/share/doc/ghostlink/docs/theme-licenses.md"
}
